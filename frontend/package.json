{
  "name": "aihistory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-prepared-catalog.mjs && next dev --webpack",
    "build": "node scripts/sync-prepared-catalog.mjs && next build --webpack",
    "start": "next start",
    "lint": "oxlint --type-aware src",
    "format": "oxfmt --write src tests next.config.ts playwright.config.ts .oxlintrc.json",
    "format:check": "oxfmt --check src tests next.config.ts playwright.config.ts .oxlintrc.json",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:scenes": "playwright test --config tests/scene-contracts.config.ts",
    "check": "node scripts/sync-prepared-catalog.mjs --check && pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "d3-geo": "3.1.2",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-zoom-pan-pinch": "4.4.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "3.1.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.1.3"
}
